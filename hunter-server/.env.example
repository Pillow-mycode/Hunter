# ===================================================================
# Hunter 配置文件 / Configuration File
# ===================================================================
#
# 配置方式（任选其一）：
#   1. 手动编辑此文件（当前方式）
#   2. 在 Web 客户端设置面板中配置（推荐，启动服务后访问浏览器）
#
# Configuration methods (choose one):
#   1. Manually edit this file (current method)
#   2. Configure via Web client settings panel (recommended, visit after starting server)
#
# LANGUAGE 选项 / options: zh (中文), en (English)
# ===================================================================

# ==================== 默认配置（快速启动只需填写这一部分） ====================
# Default Configuration (Only fill this section for quick start)
# 当各智能体的专用配置为空时，使用这些默认值
# These default values are used when agent-specific configurations are empty
DEFAULT_API_KEY=your-api-key-here
DEFAULT_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-v4-flash

# ==================== 语言配置 / Language Configuration ====================
# 设置系统语言 / Set system language
# zh = 中文 (Chinese), en = English
# 此设置会影响大模型的回复语言和系统消息
# This setting affects LLM response language and system messages
LANGUAGE=zh

# ==================== 预设厂商参考 / Preset Provider Reference ====================
# 以下是各厂商的推荐配置，取消注释即可使用。
# Preset provider configurations, uncomment to use.
#
# -- DeepSeek (推荐/Recommended) --
# DEFAULT_BASE_URL=https://api.deepseek.com
# DEFAULT_MODEL=deepseek-v4-flash          # 或/或: deepseek-v4
#
# -- 阿里云 Qwen (DashScope) --
# DEFAULT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEFAULT_MODEL=qwen3-max                   # 或/或: qwen-plus, qwen-turbo
#
# -- OpenAI --
# DEFAULT_BASE_URL=https://api.openai.com/v1
# DEFAULT_MODEL=gpt-4o
#
# -- Anthropic Claude --
# DEFAULT_BASE_URL=https://api.anthropic.com
# DEFAULT_MODEL=claude-sonnet-4-6
#
# -- 智谱 GLM (Zhipu) --
# DEFAULT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DEFAULT_MODEL=glm-4-flash
#
# -- 自定义 OpenAI 兼容 API --
# DEFAULT_BASE_URL=your-custom-api-url
# DEFAULT_MODEL=your-model-name

# ==================== 武器大师配置 / AttackToolMaster Configuration ====================
# 负责工具选择和命令执行
# Responsible for tool selection and command execution
# 留空则使用上面的 DEFAULT_ 默认值
# Leave empty to use DEFAULT_ values above
ATTACKER_API_KEY=
ATTACKER_BASE_URL=
ATTACKER_MODEL=

# ==================== 鹰眼配置 / Hawkeye Configuration ====================
# 负责检测终端是否需要用户交互
# Responsible for detecting whether the terminal requires user interaction
# 建议使用便宜的小模型 / Recommend using cheap small models
HAWKEYE_API_KEY=
HAWKEYE_BASE_URL=
HAWKEYE_MODEL=

# ==================== 渗透专家配置 / Leader Configuration ====================
# 负责任务规划和决策
# Responsible for task planning and decision-making
LEADER_API_KEY=
LEADER_BASE_URL=
LEADER_MODEL=

# ==================== 数据分析员配置 / DataAnalyst Configuration ====================
# 负责分析超长命令输出，提取关键信息
# Responsible for analyzing long command outputs and extracting key information
# 建议使用便宜的小模型，如 qwen-turbo、glm-4-flash
# Recommend using cheap small models like qwen-turbo, glm-4-flash
ANALYST_API_KEY=
ANALYST_BASE_URL=
ANALYST_MODEL=
